{
  "name": "web-ukm-uir",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "json-server": "json-server --watch db.json --port 3001 --host 0.0.0.0",
