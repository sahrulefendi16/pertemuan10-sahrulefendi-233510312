  "vite": "^6.0.0",
  "vitest": "^3.2.4",
  "json-server": "^1.0.0-beta.1",
  "concurrently": "^8.2.2",
  "@vue/test-utils": "^2.4.6",
  "jsdom": "^24.1.3"
}
}
